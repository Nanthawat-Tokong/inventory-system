# คัดลอกเป็นไฟล์ .env แล้วแก้ค่า (ไฟล์ .env ห้ามขึ้น git)
PORT=5000

# ฐานข้อมูล MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=inventory_db
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# รหัสลับสำหรับ token เข้าสู่ระบบ — ใช้ค่าสุ่มยาวๆ (เปลี่ยนแล้วทุกคนต้องล็อกอินใหม่)
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# (ไม่บังคับ) ใช้จริงแบบหน้าเว็บกับ backend คนละที่อยู่: ใส่ที่อยู่หน้าเว็บ คั่นหลายที่ด้วย ,
# ถ้า backend เสิร์ฟหน้าเว็บเอง (frontend/dist) ไม่ต้องตั้ง
# CORS_ORIGIN=https://inventory.example.com
