{
  "name": "inventory-backend",
  "version": "1.0.0",
  "description": "Centralized Inventory Management System - Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node seed.js",
    "seed:users": "node seed.js --users-only",
    "test": "jest --runInBand",
    "backup": "node scripts/backup-db.js",
    "test:load": "node tests/load/load-test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/load/"
    ]
  }
}
